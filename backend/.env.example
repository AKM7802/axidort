# Postgres connection string. Point this at Supabase's connection-pooler
# string to use Supabase; swap to any other Postgres-compatible URL to move
# providers later — nothing else in the app needs to change.
# Supabase form: postgresql+psycopg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Resend — one of the two supported email providers, see EMAIL_PROVIDER below.
RESEND_API_KEY=
RESEND_EMAIL=

# API auth (clients). Generate a real secret for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Used to build the link inside password-reset emails.
FRONTEND_URL=http://localhost:3000

# Where landing-page "contact us" submissions (pricing cards + login page)
# get emailed — see app/api/routes/contact.py.
CONTACT_RECIPIENT_EMAIL=aswinkunjufreelancer@gmail.com

# Which provider sends every app-initiated email (password reset):
# "flask_mail" (SMTP, below) or "resend" (RESEND_API_KEY/RESEND_EMAIL
# above). Default flask_mail — works immediately with e.g. a Gmail app
# password, no domain verification required. Switch to resend in
# production once a sending domain is verified at resend.com/domains
# (Resend's free tier only delivers to your own address until then).
EMAIL_PROVIDER=flask_mail

# SMTP (via Flask-Mail) — the default provider per EMAIL_PROVIDER above.
# Gmail example: MAIL_SERVER=smtp.gmail.com, MAIL_PORT=587, MAIL_USE_TLS=true,
# MAIL_USERNAME=you@gmail.com, MAIL_PASSWORD=<a Gmail App Password, not your
# regular password — required since Gmail needs 2FA + an app password for
# SMTP login: https://myaccount.google.com/apppasswords>.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
