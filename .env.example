# Postgres connection string. Point this at Supabase's connection-pooler
# string to use Supabase; swap to any other Postgres-compatible URL to move
# providers later — nothing else in the app needs to change.
# Supabase form: postgresql+psycopg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Socrata app token (recommended to avoid throttling on the Chicago API).
# https://dev.socrata.com/register
SOCRATA_APP_TOKEN=


# LLM used by the Service 1 violation classifier.
GEMINI_API_KEY=
GEMINI_MODEL=

# Resend — one of the two supported email providers, see EMAIL_PROVIDER below.
RESEND_API_KEY=
RESEND_EMAIL=

CLASSIFIER_VERSION=classify_v1
CLASSIFIER_CONFIDENCE_THRESHOLD=0.8

# Service 2 digest behavior.
# "instant": every active client is matched and emailed on every run.
# "scheduled": only clients whose next_run_at has arrived are processed.
# Either way, a successful send advances next_run_at by LEAD_LOOKBACK_DAYS.
DIGEST_SEND_MODE=scheduled
LEAD_LOOKBACK_DAYS=7

# API auth (clients). Generate a real secret for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Admin access uses this same login — a Client row with role="admin" (see
# app/models/enums.py ClientRole) can hit /admin/* with the same bearer
# token /auth/signin returns. There is no separate admin auth system.
JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Used to build the link inside password-reset emails.
FRONTEND_URL=http://localhost:3000

# Dodo Payments — powers the $199/mo subscription paywall (signup saves the
# client as UNPAID/no leads until this succeeds; see app/services/
# billing_service.py). Get API keys from the Dodo dashboard
# (Settings -> API Keys) in TEST mode while developing.
# https://docs.dodopayments.com
DODO_PAYMENTS_API_KEY=
# Developer -> Webhooks -> Create Webhook -> point it at
# {your API's public URL}/billing/webhook -> copy the signing secret here.
DODO_PAYMENTS_WEBHOOK_KEY=
# test_mode while developing; switch to live_mode only for real charges.
DODO_PAYMENTS_ENVIRONMENT=test_mode
# The pdt_... id of a $199/mo Subscription product, created in the Dodo
# dashboard (Products -> New -> Subscription, price $199.00, billed monthly).
DODO_PAYMENTS_PRODUCT_ID=

# Which provider sends every app-initiated email (password reset,
# subscription welcome, Service 2 digests): "flask_mail" (SMTP, below) or
# "resend" (RESEND_API_KEY/RESEND_EMAIL above). Default flask_mail — works
# immediately with e.g. a Gmail app password, no domain verification
# required. Switch to resend in production once a sending domain is
# verified at resend.com/domains (Resend's free tier only delivers to your
# own address until then).
EMAIL_PROVIDER=flask_mail

# SMTP (via Flask-Mail) — the default provider per EMAIL_PROVIDER above.
# scripts/resend_digest.py always uses this directly regardless of
# EMAIL_PROVIDER, to retry a client's digest through the other provider
# when the configured default one is what failed.
# Gmail example: MAIL_SERVER=smtp.gmail.com, MAIL_PORT=587, MAIL_USE_TLS=true,
# MAIL_USERNAME=you@gmail.com, MAIL_PASSWORD=<a Gmail App Password, not your
# regular password — required since Gmail needs 2FA + an app password for
# SMTP login: https://myaccount.google.com/apppasswords>.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
